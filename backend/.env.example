# Production configuration. backend/dev.py defaults to its local SQLite file.
DATABASE_URL=sqlite:///./playaxis.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-generated-random-secret
FRONTEND_URL=http://localhost:3000

# Free full-league and local-event access. Keep keys on the backend.
# FOOTBALL_DATA_API_KEY=
# BALLDONTLIE_API_KEY=
# TICKETMASTER_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Optional broader organiser search. Explicit submitted searches only.
# SERPAPI_API_KEY=
LOCAL_SEARCH_MONTHLY_LIMIT=100

# Optional SportsDB override; public key 123 is used otherwise.
# THESPORTSDB_API_KEY=

# Optional archived-data key. Current NBA uses BALLDONTLIE, since the tested
# API-Sports free plan restricted current seasons.
# API_SPORTS_KEY=

# Place search overrides and persistent last-good cache.
# OVERPASS_API_URL=https://your-overpass-host/api/interpreter
# PLACE_CACHE_DIR=./.cache/places

# Optional contact API. The website prepares email drafts without SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# CONTACT_SENDER_EMAIL=
# CONTACT_SENDER_PASSWORD=
# CONTACT_RECIPIENT_EMAIL=
