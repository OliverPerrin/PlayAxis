# Leave unset to use the local CRA proxy or the production same-origin proxy.
# A backend origin or full /api/v1 URL is accepted.
# REACT_APP_API_URL=http://localhost:8000

# Optional map tile provider override. Set its required attribution as well.
# REACT_APP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# REACT_APP_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
